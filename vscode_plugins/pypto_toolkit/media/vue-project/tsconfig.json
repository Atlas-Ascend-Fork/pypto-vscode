{
  "compilerOptions": {
    "module": "ES2022",
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "noImplicitOverride": true,
    "resolveJsonModule": true,
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "ext:/*": ["../../src/*"]
    }
  },
  "include": ["./src/**/*", "./env.d.ts"]
}
