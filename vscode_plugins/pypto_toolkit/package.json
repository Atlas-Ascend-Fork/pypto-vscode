{
  "name": "pypto-toolkit",
  "displayName": "PyPTO Toolkit",
  "description": "PyPTO 效率提升插件",
  "version": "0.1.10",
  "icon": "media/images/logo.png",
  "engines": {
    "vscode": "^1.45.2"
  },
  "publisher": "HiSmartLiteOpen",
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "category": "PyPTO.renderGraph",
        "command": "PyPTO.OpenRenderGraphForCurrent",
        "title": "%pypto.OpenRenderGraphForCurrent%"
      },
      {
        "command": "PyPTO.deletePersistFile",
        "title": "Delete Cache DB File",
        "category": "PyPTO.comGraph"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "PyPTO.OpenRenderGraphForCurrent",
          "when": "resourceExtname == .json",
          "group": "navigation"
        }
      ]
    },
    "configuration": [
      {
        "id": "computational",
        "title": "Computational Graph",
        "properties": {
          "PyPTOToolkit.tensorAttr": {
            "type": "string",
            "default": "",
            "description": "%PyPTOToolkit.tensorAttr.description%"
          },
          "PyPTOToolkit.tensorColor": {
            "type": "string",
            "default": "",
            "description": "%PyPTOToolkit.tensorColor.description%"
          },
          "PyPTOToolkit.operationAttr": {
            "type": "string",
            "default": "",
            "description": "%PyPTOToolkit.operationAttr.description%"
          },
          "PyPTOToolkit.operationColor": {
            "type": "string",
            "default": "",
            "description": "%PyPTOToolkit.operationColor.description%"
          }
        }
      },
      {
        "id": "swimlane",
        "title": "Swimlane Diagram",
        "properties": {
          "PyPTOToolkit.ZoomInShortcut": {
            "type": "string",
            "default": "w",
            "description": "%PyPTOToolkit.ZoomIn.description%"
          },
          "PyPTOToolkit.ZoomOutShortcut": {
            "type": "string",
            "default": "s",
            "description": "%PyPTOToolkit.ZoomOut.description%"
          },
          "PyPTOToolkit.leftmoveShortcut": {
            "type": "string",
            "default": "a",
            "description": "%PyPTOToolkit.leftmove.description%"
          },
          "PyPTOToolkit.rightmoveShortcut": {
            "type": "string",
            "default": "d",
            "description": "%PyPTOToolkit.rightmove.description%"
          },
          "PyPTOToolkit.connectionLevel": {
            "type": "number",
            "default": -1,
            "description": "%PyPTOToolkit.connectionLevel.description%"
          }
        }
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "npm run build:webview && tsc -p ./",
    "dev:webview": "cd media/vue-project && npm run dev",
    "build:webview": "cd media/vue-project && npm run build-only && cd ../../",
    "lint": "eslint . --fix",
    "postcompile": "node scripts/copy-wasm.js",
    "pretest": "npm run lint"
  },
  "dependencies": {
    "@types/vscode": "^1.52.0",
    "@material/material-color-utilities": "^0.3.0",
    "child_process": "^1.0.2",
    "bignumber.js" : "9.3.1",
    "d3": "^3.5.16",
    "dagre": "0.8.5",
    "elkjs": "^0.8.2",
    "i18next": "^22.4.14",
    "jquery": "^3.7.1",
    "jquery.json-viewer": "^1.5.0",
    "moment": "^2.29.4",
    "sprotty-elk": "^1.4.0",
    "sql.js": "^1.13.0",
    "stream-json": "^1.9.1",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "copy-webpack-plugin": "^11.0.0",
    "@commitlint/cli": "^11.0.0",
    "@commitlint/config-conventional": "^11.0.0",
    "@types/sql.js": "^1.4.4",
    "eslint": "^8.34.0",
    "glob": "^7.1.6",
    "husky": "^4.3.0",
    "mocha": "^7.0.1",
    "vscode-test": "^1.3.0",
    "webpack": "^5.1.0",
    "webpack-cli": "^4.10.0"
  },
  "extensionDependencies": [],
  "repository": {},
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  }
}
