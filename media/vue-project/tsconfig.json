{
  "compilerOptions": {
    "module": "ES2022",
    "moduleResolution": "bundler",
    "experimentalDecorators": true,
    "noImplicitOverride": true,
    "resolveJsonModule": true,
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"],
      "ext:/*": ["../../src/*"]
    }
  },
  "include": ["./src/**/*", "./env.d.ts"],
  "exclude": ["./src/**/__tests__/*", "./src/test/*"]
}
