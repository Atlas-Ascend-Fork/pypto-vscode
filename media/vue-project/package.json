{
  "name": "vue-project",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run type-check && npm run build-only",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "type-check:tests": "vue-tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint . --fix",
    "lint:check": "eslint . --max-warnings=0",
    "lint:memory": "eslint src/components/memoryUsage --fix",
    "lint:memory:check": "eslint src/components/memoryUsage --max-warnings=0",
    "test": "vitest",
    "test:run": "vitest run",
    "test:memory": "vitest run src/components/memoryUsage/__tests__"
  },
  "dependencies": {
    "@antv/g6": "^5.0.49",
    "@devui-design/icons": "^1.4.0",
    "@material/material-color-utilities": "^0.3.0",
    "@pypto/data-compress": "^0.0.8",
    "@vue-flow/core": "^1.48.2",
    "bignumber.js": "9.3.1",
    "devui-theme": "^0.1.0",
    "diff": "^8.0.2",
    "elkjs": "^0.8.2",
    "inversify": "^6.2.2",
    "lodash-es": "^4.18.1",
    "monaco-editor": "^0.52.2",
    "reflect-metadata": "^0.2.2",
    "sprotty": "^1.4.0",
    "sprotty-elk": "^1.4.0",
    "sprotty-protocol": "^1.4.0",
    "vue": "^3.5.43",
    "vue-devui": "^1.6.37",
    "vue-i18n": "11.1.10"
  },
  "devDependencies": {
    "@tsconfig/node20": "^20.1.2",
    "@types/node": "^22.12.0",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/test-utils": "2.4.11",
    "@vue/tsconfig": "^0.5.1",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "fs-extra": "^11.3.0",
    "jsdom": "^29.1.1",
    "less": "^4.4.2",
    "sass": "^1.90.0",
    "typescript": "~5.4.0",
    "typescript-eslint": "8.69.0",
    "vite": "8.1.5",
    "vitest": "4.1.11",
    "vue-tsc": "^2.0.6"
  },
  "overrides": {
    "glob": "^10.5.0",
    "katex": "^0.19.0",
    "markdown-it": "^14.3.2"
  }
}
