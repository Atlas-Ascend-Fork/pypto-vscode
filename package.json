{
  "name": "pypto-toolkit",
  "displayName": "PyPTO Toolkit",
  "description": "PyPTO 效率提升插件",
  "version": "2.1.1",
  "license": "Apache-2.0",
  "icon": "media/images/logo.png",
  "engines": {
    "vscode": "^1.82.0",
    "node": ">=22.13"
  },
  "publisher": "CANN-PUB",
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "submenus": [
      {
        "id": "pypto.graph.advanOpen",
        "label": "%pypto.OpenGraphForAdvanceFeatures%"
      }
    ],
    "commands": [
      {
        "category": "PyPTO.renderGraph",
        "command": "PyPTO.Open.OpenRenderGraphForCurrent",
        "title": "%pypto.OpenRenderGraphForCurrent%"
      },
      {
        "command": "PyPTO.readCsv",
        "title": "读取csv数据",
        "category": "PyPTO.readCsv"
      },
      {
        "command": "PyPTO.getCsvData",
        "title": "查询csv数据",
        "category": "PyPTO.getCsvData"
      },
      {
        "command": "PyPTO.Open.deletePersistFile",
        "title": "Delete Cache DB File",
        "category": "PyPTO.comGraph"
      },
      {
        "category": "PyPTO.renderDiffComGraph",
        "command": "PyPTO.Open.OpenDiffComGraphForCurrent",
        "title": "%pypto.OpenDiffComGraphForCurrent%"
      },
      {
        "category": "PyPTO.renderNodeSearch",
        "command": "PyPTO.Open.OpenComGraphForNodeSearch",
        "title": "%pypto.OpenComGraphForNodeSearch%"
      },
      {
        "command": "PyPTO.Open.OpenGmMemoryVisualization",
        "title": "%pypto.OpenGmMemoryVisualization%"
      },
      {
        "category": "PyPTO.OpenLinkageMode",
        "command": "PyPTO.Open.OpenLinkageMode",
        "title": "%PyPTO.OpenLinkageMode%"
      },
      {
        "category": "PyPTO.CloseAllToolPages",
        "command": "PyPTO.Open.CloseAllToolPages",
        "title": "%PyPTO.CloseAllToolPages%"
      },
      {
        "command": "PyPTO.Open.OpenSwimGraph",
        "title": "%pypto.OpenSwimGraph%",
        "category": "PyPTO.OpenSwimGraph"
      },
      {
        "command": "PyPTO.Open.OpenWelcomeGuide",
        "title": "%PyPTOToolkit.welcome.open%",
        "category": "PyPTO.OpenWelcomeGuide",
        "icon": {
          "light": "webview-dist/static-assets/boot_steps/boot_steps_open_sideBar-light.svg",
          "dark": "webview-dist/static-assets/boot_steps/boot_steps_open_sideBar.svg"
        }
      },
      {
        "command": "PyPTO.ExecuteRemoteCommand",
        "title": "%pypto.remoteTool.executeCommand%",
        "category": "PyPTO.RemoteTool"
      },
      {
        "command": "PyPTO.Open.OpenWaveform",
        "title": "%pypto.OpenWaveform%",
        "category": "PyPTO.OpenWaveform"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "PyPTO.Open.OpenRenderGraphForCurrent",
          "when": "resourceExtname == .json && resourceFilename != memory_usage_visualization.json",
          "group": "navigation@1"
        },
        {
          "submenu": "pypto.graph.advanOpen",
          "when": "resourceExtname == .json",
          "group": "navigation@2"
        },
        {
          "command": "PyPTO.Open.OpenLinkageMode",
          "when": "resourceExtname == .py || resourceExtname == .cpp",
          "group": "navigation"
        },
        {
          "command": "PyPTO.Open.OpenWaveform",
          "when": "resourceExtname == .vcd",
          "group": "navigation@3"
        }
      ],
      "pypto.graph.advanOpen": [
        {
          "command": "PyPTO.Open.OpenDiffComGraphForCurrent",
          "when": "resourceExtname == .json && resourceFilename != memory_usage_visualization.json",
          "group": "1_graph@1"
        },
        {
          "command": "PyPTO.Open.OpenComGraphForNodeSearch",
          "when": "resourceExtname == .json && resourceFilename != memory_usage_visualization.json",
          "group": "1_graph@2"
        },
        {
          "command": "PyPTO.Open.OpenGmMemoryVisualization",
          "when": "resourceFilename == memory_usage_visualization.json",
          "group": "1_graph@3"
        }
      ],
      "editor/context": [
        {
          "command": "PyPTO.Open.OpenLinkageMode",
          "when": "resourceExtname == .py || resourceExtname == .cpp",
          "group": "navigation"
        }
      ],
      "editor/title/context": [
        {
          "command": "PyPTO.Open.CloseAllToolPages",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "PyPTO.Open.OpenWelcomeGuide",
          "when": "view == PyPTO-Open-Toolkit-Sidebar",
          "group": "navigation@1"
        }
      ]
    },
    "configuration": {
      "id": "swimlane",
      "title": "PyPTO Toolkit",
      "properties": {
        "PyPTOToolkitOpen.ZoomInShortcut": {
          "type": "string",
          "default": "w",
          "description": "%PyPTOToolkit.ZoomIn.description%"
        },
        "PyPTOToolkitOpen.ZoomOutShortcut": {
          "type": "string",
          "default": "s",
          "description": "%PyPTOToolkit.ZoomOut.description%"
        },
        "PyPTOToolkitOpen.leftmoveShortcut": {
          "type": "string",
          "default": "a",
          "description": "%PyPTOToolkit.leftmove.description%"
        },
        "PyPTOToolkitOpen.rightmoveShortcut": {
          "type": "string",
          "default": "d",
          "description": "%PyPTOToolkit.rightmove.description%"
        },
        "PyPTOToolkitOpen.connectionLevel": {
          "type": "number",
          "default": -1,
          "description": "%PyPTOToolkit.connectionLevel.description%"
        },
        "PyPTOToolkitOpen.showPerformancePanel": {
          "type": "boolean",
          "default": true,
          "description": "%PyPTOToolkit.showPerformancePanel.description%"
        },
        "PyPTOToolkitOpen.showIsMixMode": {
          "type": "boolean",
          "default": false,
          "description": "%PyPTOToolkit.showIsMixMode.description%"
        },
        "PyPTOToolkitOpen.enableNativeLayout": {
          "type": "boolean",
          "default": true,
          "description": "%PyPTOToolkit.enableNativeLayout.description%"
        }
      }
    },
    "customEditors": [
      {
        "viewType": "PyPTO.open.editorView",
        "displayName": "PyPTO Toolkit",
        "selector": [
          {
            "filenamePattern": "PyPTO:/**"
          }
        ],
        "priority": "default"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sidebar",
          "title": "PyPTO Toolkit",
          "icon": "media/images/logo.png"
        }
      ]
    },
    "views": {
      "sidebar": [
        {
          "type": "webview",
          "id": "PyPTO-Open-Toolkit-Sidebar",
          "name": "PyPTO Toolkit",
          "icon": "media/images/logo.png"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "node build/check-env.js && git lfs pull && npm run compile",
    "watch": "npm run clean && concurrently \"npm run dev:webview\" \"npm run watch:vscode\"",
    "watch:vscode": "tsc -p ./ --watch",
    "compile": "npm run clean && concurrently --kill-others-on-fail \"npm run build:webview\" \"npm run compile:vscode\"",
    "compile:vscode": "tsc -p ./",
    "dev:webview": "cd media/vue-project && npm run dev",
    "build:webview": "cd media/vue-project && npm run build-only && cd ../../",
    "type-check:webview": "cd media/vue-project && npm run type-check",
    "type-check:webview:tests": "cd media/vue-project && npm run type-check:tests",
    "clean": "node build/clean-output.mjs",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "lint:webview": "cd media/vue-project && npm run lint",
    "lint:webview:check": "cd media/vue-project && npm run lint:check",
    "check": "npm run compile:vscode && npm run type-check:webview",
    "test:memory": "npm run type-check:webview:tests && npm --prefix media/vue-project run test:memory",
    "test:gm-e2e:type-check": "tsc --noEmit -p test/e2e/tsconfig.json",
    "test:gm-e2e": "npm run test:gm-e2e:type-check && playwright test --config test/e2e/playwright.config.ts",
    "test:gm-perf": "npm run test:gm-e2e:type-check && playwright test --config test/e2e/playwright.config.ts",
    "test:prepare": "npm run clean && concurrently --kill-others-on-fail \"npm run build:webview\" \"npm run compile:vscode\" && tsc -p tsconfig.test.json",
    "test:gm-smoke:run": "vscode-test --config .vscode-test.json --label gm-memory",
    "test:gm-smoke": "npm run test:prepare && npm run test:gm-smoke:run",
    "test": "npm run test:memory && npm run test:prepare && npm run test:gm-e2e && npm run test:gm-smoke:run",
    "prepare": "husky"
  },
  "dependencies": {
    "@material/material-color-utilities": "^0.3.0",
    "@pypto/data-compress": "^0.0.8",
    "@pypto/native-layout": "^0.0.1",
    "@types/vscode": "^1.52.0",
    "core-js": "^3.47.0",
    "csv-parse": "^7.0.2",
    "dayjs": "^1.11.19",
    "elkjs": "^0.8.2",
    "i18next": "^26.4.2",
    "lodash": "^4.17.21",
    "sprotty-protocol": "^1.4.0",
    "sql.js": "^1.13.0",
    "stream-chain": "^4.2.6",
    "stream-json": "^3.7.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.0.0",
    "@playwright/test": "1.61.1",
    "@types/lodash": "^4.17.21",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.12.0",
    "@types/sql.js": "^1.4.4",
    "@typescript-eslint/parser": "^8.69.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.0.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.5",
    "husky": "^9.1.7",
    "mocha": "^11.8.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "diff": "^8.0.3",
    "mocha": {
      "glob": "^10.5.0"
    },
    "minimatch@^10.2.6": {
      "brace-expansion": "^5.0.12"
    }
  },
  "extensionDependencies": [],
  "repository": {}
}
