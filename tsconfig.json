{
"compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "outDir": "dist",
    "lib": ["ES2022","dom"],
    "sourceMap": true,
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noImplicitAny": false,
    "noImplicitOverride": true,
    "jsx": "react",
    "noUnusedLocals": false,
    "strictPropertyInitialization": false,
    "noEmitOnError": false,
    "declaration": true,
    "declarationMap": false,
    "moduleResolution": "node",
    "paths": {
      "stream-json/streamers/stream-values.js": ["./node_modules/stream-json/src/streamers/stream-values.d.ts"],
      "stream-json/streamers/stream-array.js": ["./node_modules/stream-json/src/streamers/stream-array.d.ts"],
      "stream-json/streamers/stream-object.js": ["./node_modules/stream-json/src/streamers/stream-object.d.ts"]
    },
    "typeRoots": ["node_modules/@types"],
    "types": ["node"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "src/test"]
}
